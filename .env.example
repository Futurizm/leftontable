# Google Cloud service account with Vertex AI access, as base64 of the JSON key file:
#   base64 -w0 service-account.json
GOOGLE_SERVICE_ACCOUNT_BASE64=
# (alternative) raw JSON on one line
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Vertex AI location and models (first one that works is used)
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODELS=gemini-3.5-flash,gemini-3-flash-preview
# LOW (fast, default) or HIGH
GEMINI_THINKING_LEVEL=LOW

# Public URL used for Open Graph images
NEXT_PUBLIC_SITE_URL=
